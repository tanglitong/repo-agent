{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "version", "status", "steps"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "const": 1 },
    "status": { "const": "approved" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
