{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "candidate_id", "status", "trusted", "type", "pattern", "recommendation", "evidence", "review", "score", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "validated", "team_proposed", "approved", "rejected", "quarantined", "superseded", "merged", "stale", "archived"] },
    "trusted": { "type": "boolean" },
    "type": { "const": "fix_pattern" },
    "pattern": { "type": "string", "minLength": 1 },
    "recommendation": { "type": "string", "minLength": 1 },
    "evidence": { "type": "object" },
    "review": { "type": "object" },
    "score": { "type": "object" },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
