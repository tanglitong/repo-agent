{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "version", "status", "patterns", "guidance"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "const": 1 },
    "status": { "const": "approved" },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "guidance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "recurrence": {
      "type": "object",
      "properties": {
        "occurrences": { "type": "number" }
      }
    }
  }
}
